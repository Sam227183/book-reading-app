<div class="row">
  <div class="col-md-8">
    <h2><%= @user.name || @user.email %></h2>
    <p class="text-muted"><%= @user.email %></p>

    <% if current_user == @user %>
      <%= link_to "Edit profile", edit_user_registration_path, class: "btn btn-outline-primary btn-sm mt-2" %>
    <% end %>

    <h4 class="mt-4">Reviews</h4>
    <% if @user.reviews.empty? %>
      <p class="text-muted">No reviews yet.</p>
    <% else %>
      <% @user.reviews.each do |review| %>
        <div class="card mb-3">
          <div class="card-body">
            <h6><%= link_to review.book.title, book_path(review.book) %></h6>
            <div class="d-flex justify-content-between">
              <span class="badge status-<%= review.status %>"><%= review.status %></span>
              <span class="text-muted">Rating: <%= review.rating %> / 5</span>
            </div>
            <p class="mt-2 mb-0"><%= review.body %></p>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
