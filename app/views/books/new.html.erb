<h2>Add a Book</h2>

<%= form_with model: @book, class: "mt-3" do |f| %>
  <div class="mb-3">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :author, class:"form-label" %>
    <%= f.text_field :author, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :genre, class: "form-label" %>
    <%= f.select :genre, Book.genres.keys.map { |g| [g.capitalize, g] }, { prompt: "Select a genre" }, class: "form-select" %>
  </div>

  <%= f.submit "Add Book", class: "btn btn-primary"%>
<% end %>