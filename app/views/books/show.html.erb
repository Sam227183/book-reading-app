<div class="row">
  <div class="col-md-8">
    <h1 class="mb-1"><%= @book.title %></h1>
    <p class="text-muted mb-1"><%= @book.author %></p>
    <span class="badge bg-secondary mb-4"><%= @book.genre %></span>

    <h4 class="mt-4">Reviews</h4>

    <% if @book.reviews.empty? %>
      <p class="text-muted">No reviews yet.</p>
    <% else %>
      <% @book.reviews.each do |review| %>
        <div class="card mb-3">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="d-flex gap-2">
                  <span class="badge bg-primary"><%= review.status %></span>
                  <span class="text-muted">Rating: <%= review.rating %> / 5</span>
                </div>
                <p class="mt-2 mb-0"><%= review.body %></p>
                <small class="text-muted">by <%= link_to review.user.name || review.user.email, user_path(review.user) %></small>
              </div>
              <% if user_signed_in? && current_user == review.user %>
                <%= button_to "Delete", book_review_path(@book, review), method: :delete, class: "btn btn-outline-danger btn-sm", form: { data: { turbo_confirm: "Are you sure?" } } %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>

    <h4 class="mt-4">Add a Review</h4>
    <%= form_with model: [@book, Review.new], class: "mt-3" do |f| %>
      <div class="mb-3">
        <%= f.label :status, class: "form-label" %>
        <%= f.select :status, Review.statuses.keys, {}, class: "form-select" %>
      </div>
      <div class="mb-3">
        <%= f.label :rating, class: "form-label" %>
        <%= f.number_field :rating, min: 1, max: 5, class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= f.label :body, class: "form-label" %>
        <%= f.text_area :body, rows: 4, class: "form-control" %>
      </div>
      <%= f.submit "Save Review", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>

<div class="mt-4">
  <%= link_to "← Back to all books", books_path, class: "btn btn-outline-secondary" %>
</div>
