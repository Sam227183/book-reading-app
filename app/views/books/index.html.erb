<h1 class="mb-4 page-title">List of Books</h1>

<div class="row row-cols-1 row-cols-md-3 g-4">
  <% @books.each do |book| %>
    <div class="col">
      <div class="card h-100">
        <% if book.bookcover %>
          <%= image_tag book.bookcover_url(:thumbnail), class: "card-img-top", style: "object-fit: cover; height: 200px;" %>
        <% end %>
        <div class="card-body">
          <h5 class="card-title">
            <%= link_to book.title, book_path(book), class: "text-decoration-none" %>
            <% if book.reviews.any? %>🏅 <%= book.reviews.size %><% end %>
          </h5>
          <p class="card-text text-muted"><%= book.author %></p>
          <span class="badge genre-<%= book.genre %>"><%= book.genre %></span>
        </div>
      </div>
    </div>
  <% end %>
</div>
