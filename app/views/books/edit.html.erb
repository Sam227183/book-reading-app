<h1 class="mb-4">Edit Book Cover</h1>

<%= form_with model: @book, multipart: true do |f| %>
  <div class="mb-3">
    <% if @book.bookcover %>
      <%= image_tag @book.bookcover_url(:thumbnail) || @book.bookcover_url, class: "mb-2 d-block", style: "max-width: 150px;" %>
    <% end %>
    <%= f.label :bookcover, "Upload new cover", class: "form-label" %>
    <%= f.file_field :bookcover, class: "form-control" %>
  </div>
  <%= f.submit "Update Cover", class: "btn btn-primary" %>
<% end %>

<div class="mt-3">
  <%= link_to "← Back", @book, class: "btn btn-outline-secondary" %>
</div>
