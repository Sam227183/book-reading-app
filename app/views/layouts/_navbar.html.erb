<nav class="navbar navbar-expand-lg navbar-light bg-light px-4">
  <%= link_to "Book Reading", root_path, class: "navbar-brand brand-title" %>
  <div class="ms-auto">
    <% if user_signed_in? %>
      <% stale_count = current_user.reviews.stale_reading.count %>
      <% if stale_count > 0 %>
        <%= link_to user_path(current_user), class: "btn btn-outline-warning btn-sm me-2" do %>
          Reading <span class="badge bg-danger"><%= stale_count %></span>
        <% end %>
      <% end %>
      <%= link_to "Add Book", new_book_path, class: "btn btn-success btn-sm me-2" %>
      <%= link_to current_user.name || current_user.email, user_path(current_user), class: "btn btn-outline-secondary btn-sm me-2" %>
      <%= button_to "Log out", destroy_user_session_path, method: :delete, form: { class: "d-inline" }, class: "btn btn-outline-danger btn-sm" %>
    <% else %>
      <%= link_to "Log in", new_user_session_path, class: "btn btn-outline-primary btn-sm me-2" %>
      <%= link_to "Sign up", new_user_registration_path, class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>
</nav>